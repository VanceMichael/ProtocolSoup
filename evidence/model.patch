+	etag := generationETag(g)
+	if !ifNoneMatch(r, etag) {
+		return false
+	}
+	header := w.Header()
+	header.Set("Cache-Control", cacheControl)
+	header.Set("ETag", etag)
+	w.WriteHeader(http.StatusNotModified)
+	return true
